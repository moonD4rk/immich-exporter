immich_album_assets 500
# HELP immich_album_assets_avg Average asset count per album.
# TYPE immich_album_assets_avg gauge
immich_album_assets_avg 250
# HELP immich_album_assets_max Asset count of the largest album.
# TYPE immich_album_assets_max gauge
immich_album_assets_max 500
